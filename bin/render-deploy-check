#!/usr/bin/env bash
# Find the Render services built from a GitHub repo and report (or wait for)
# the deploy of a given commit, with logs when it fails.
#
#   render-deploy-check [--repo owner/name] [--branch BRANCH] [--sha SHA]
#                       [--service NAME_OR_ID] [--wait] [--timeout SECONDS] [--logs N]
#
# Defaults come from the git repo in the current directory: origin remote,
# current branch, HEAD sha. Exit codes: 0 live on the requested sha,
# 1 deploy failed, 2 timed out / not deployed yet, 3 usage or lookup error.
set -euo pipefail

API="https://api.render.com/v1"
repo="" branch="" sha="" service="" wait=0 timeout=900 nlogs=60
while [ $# -gt 0 ]; do
  case "$1" in
    --repo) repo="$2"; shift 2 ;;
    --branch) branch="$2"; shift 2 ;;
    --sha) sha="$2"; shift 2 ;;
    --service) service="$2"; shift 2 ;;
    --wait) wait=1; shift ;;
    --timeout) timeout="$2"; shift 2 ;;
    --logs) nlogs="$2"; shift 2 ;;
    -h|--help) sed -n '2,11p' "$0"; exit 0 ;;
    *) echo "unknown argument: $1" >&2; exit 3 ;;
  esac
done
[ -n "${RENDER_API_KEY:-}" ] || { echo "RENDER_API_KEY is not set" >&2; exit 3; }

if git rev-parse --git-dir >/dev/null 2>&1; then
  if [ -z "$repo" ]; then
    url="$(git remote get-url origin 2>/dev/null || true)"
    repo="$(sed -E 's#(git@github.com:|https://github.com/)##; s#\.git$##' <<<"$url")"
  fi
  [ -n "$branch" ] || branch="$(git branch --show-current)"
  [ -n "$sha" ] || sha="$(git rev-parse HEAD)"
fi

api() { curl -fsS -H "Authorization: Bearer $RENDER_API_KEY" -H "Accept: application/json" "$API$1"; }

services="$(api "/services?limit=100" | jq -c '[.[].service]')"
if [ -n "$service" ]; then
  matches="$(jq -c --arg s "$service" '[.[] | select(.id == $s or .name == $s)]' <<<"$services")"
else
  [ -n "$repo" ] || { echo "no --repo/--service given and no git origin here" >&2; exit 3; }
  matches="$(jq -c --arg r "$repo" --arg b "$branch" '[.[] | select((.repo // "" | ascii_downcase | rtrimstr(".git")) == ("https://github.com/" + $r | ascii_downcase))
             | select($b == "" or .branch == $b)]' <<<"$services")"
fi
count="$(jq length <<<"$matches")"
if [ "$count" -eq 0 ]; then
  echo "No Render service found for repo=${repo:-?} branch=${branch:-any} service=${service:-?}."
  echo "Services in this account:"; jq -r '.[] | "  \(.name)  \(.id)  \(.repo // "-")@\(.branch // "-")"' <<<"$services"
  exit 3
fi

terminal='^(live|deactivated|build_failed|update_failed|canceled|pre_deploy_failed)$'
rc=0
for row in $(jq -r '.[] | @base64' <<<"$matches"); do
  svc="$(base64 -d <<<"$row")"
  id="$(jq -r .id <<<"$svc")"; name="$(jq -r .name <<<"$svc")"; owner="$(jq -r .ownerId <<<"$svc")"
  echo "== $name ($id)  repo=$(jq -r '.repo // "-"' <<<"$svc")  branch=$(jq -r '.branch // "-"' <<<"$svc")"
  echo "   url=$(jq -r '.serviceDetails.url // "-"' <<<"$svc")  autoDeploy=$(jq -r .autoDeploy <<<"$svc")  suspended=$(jq -r .suspended <<<"$svc")"
  deadline=$(( $(date +%s) + timeout ))
  while :; do
    deploys="$(api "/services/$id/deploys?limit=10" | jq -c '[.[].deploy]')"
    if [ -n "$sha" ]; then
      dep="$(jq -c --arg s "$sha" '[.[] | select(.commit.id // "" | startswith($s))][0] // empty' <<<"$deploys")"
    else
      dep="$(jq -c '.[0] // empty' <<<"$deploys")"
    fi
    status="$(jq -r '.status // "none"' <<<"${dep:-{\}}")"
    if [ "$wait" -eq 0 ] || [[ "$status" =~ $terminal ]] || [ "$(date +%s)" -ge "$deadline" ]; then break; fi
    echo "   waiting: deploy for ${sha:0:7} is '$status'..."; sleep 15
  done
  live="$(jq -c '[.[] | select(.status == "live")][0] // empty' <<<"$deploys")"
  echo "   requested sha=${sha:-latest}  deploy=$(jq -r '.id // "-"' <<<"${dep:-{\}}")  status=$status"
  echo "   currently live: sha=$(jq -r '.commit.id // "-"' <<<"${live:-{\}}")  msg=$(jq -r '(.commit.message // "-") | split("\n")[0]' <<<"${live:-{\}}")  finished=$(jq -r '.finishedAt // "-"' <<<"${live:-{\}}")"
  case "$status" in
    live) [ -z "$sha" ] || [[ "$(jq -r '.commit.id' <<<"$live")" == "$sha"* ]] || { echo "   NOTE: requested deploy reported live but is not the current live deploy"; }; ;;
    build_failed|update_failed|pre_deploy_failed|canceled)
      rc=1; echo "   DEPLOY FAILED ($status). Last $nlogs build+app log lines:"
      api "/logs?ownerId=$owner&resource=$id&limit=$nlogs&direction=backward" \
        | jq -r '.logs | reverse | .[] | "   | \(.timestamp[11:19]) \(.labels | map(select(.name=="type"))[0].value // "") \(.message)"' || true ;;
    none) [ "$rc" -ne 0 ] || rc=2; echo "   no deploy found for this sha (autoDeploy off, or not pushed/started yet)";;
    *) [ "$rc" -ne 0 ] || rc=2; echo "   deploy still in progress or timed out ($status)";;
  esac
done
exit "$rc"
