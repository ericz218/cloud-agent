#!/usr/bin/env bash
# Run a coding task with the BYOK OpenCode agent and print a short result.
#
#   oc-agent [-c] [-m MODEL] [-e EFFORT] [-d DIR] "task description"
#     -c      continue the previous OpenCode session (follow-up instructions)
#     -m      model ID for this task (one of BYOK_MODEL / BYOK_SMALL_MODEL / BYOK_EXTRA_MODELS)
#     -e      reasoning effort for this task (low | medium | high | xhigh | max); default BYOK_REASONING_EFFORT
#     -d DIR  working directory (default: current directory)
#
# Model/API come from BYOK_PROVIDER, BYOK_BASE_URL, BYOK_MODEL, BYOK_API_KEY.
# The full transcript goes to /tmp/oc-agent/*.log; only its tail is printed so
# the calling (relay) model reads as little as possible.
set -uo pipefail

cont=() model=() pick="" dir="$PWD"
while getopts "cm:e:d:h" o; do
  case "$o" in
    c) cont=(--continue) ;;
    m) model=(--model "byok/$OPTARG"); pick="$OPTARG" ;;
    e) export BYOK_REASONING_EFFORT="$OPTARG" ;;
    d) dir="$OPTARG" ;;
    *) sed -n '2,12p' "$0"; exit 2 ;;
  esac
done
shift $((OPTIND - 1))
[ $# -gt 0 ] || { sed -n '2,12p' "$0"; exit 2; }

# Profile defaults (non-secret): the one chosen by `setup.sh <profile>`, else the
# profile whose BYOK_BASE_URL matches the configured one. Real env vars win.
profile=/opt/cloud-agent/profile.env
if [ ! -f "$profile" ] && [ -n "${BYOK_BASE_URL:-}" ]; then
  profile="$(grep -lxF "BYOK_BASE_URL=${BYOK_BASE_URL%/}" /opt/cloud-agent/profiles/*.env 2>/dev/null | head -n 1)"
fi
if [ -n "$profile" ] && [ -f "$profile" ]; then
  while IFS='=' read -r k v; do
    case "$k" in BYOK_*) [ -n "${!k:-}" ] || export "$k=$v" ;; esac
  done < <(grep -E '^[A-Z_]+=' "$profile")
fi

for v in BYOK_MODEL BYOK_API_KEY; do
  if [ -z "${!v:-}" ]; then
    echo "oc-agent: $v is not set. Add it under the cloud environment's settings → Environment variables, then start a new session." >&2
    exit 3
  fi
done

# A model picked with -m is always selectable, even if it is not in the configured lists.
[ -z "$pick" ] || export BYOK_EXTRA_MODELS="${BYOK_EXTRA_MODELS:+$BYOK_EXTRA_MODELS,}$pick"

# Meta's *-contributor models reject reasoning effort "max"; use the next level down.
if [ "${BYOK_REASONING_EFFORT:-}" = "max" ] && [[ "${model[1]:-byok/$BYOK_MODEL}" == *-contributor ]]; then
  echo "oc-agent: ${model[1]:-$BYOK_MODEL} does not support effort max, using xhigh" >&2
  export BYOK_REASONING_EFFORT=xhigh
fi

cfg="${XDG_CONFIG_HOME:-$HOME/.config}/opencode/opencode.json"
/opt/cloud-agent/gen-opencode-config.sh "$cfg" || exit 3

mkdir -p /tmp/oc-agent
log="/tmp/oc-agent/$(date +%Y%m%d-%H%M%S).log"
cd "$dir" || exit 2
echo "oc-agent: model=${model[1]:-byok/$BYOK_MODEL} effort=${BYOK_REASONING_EFFORT:-model-default} dir=$dir log=$log" >&2

# Startup can hang on OpenCode's background models.dev download (6 MB, no timeout) when the
# network is flaky. Our models are configured explicitly, so skip it. As a safety net, an
# attempt that hasn't started its agent loop within $OC_AGENT_START_TIMEOUT seconds is
# killed and retried.
export OPENCODE_DISABLE_MODELS_FETCH=1 OPENCODE_DISABLE_AUTOUPDATE=1
start_timeout="${OC_AGENT_START_TIMEOUT:-120}"
raw="$log.raw"
# Live view for oc-progress: the run currently (or most recently) in progress.
ln -sfn "$raw" /tmp/oc-agent/current.raw
printf '%s %s %s\n' "$$" "$(date +%s)" "${model[1]:-byok/$BYOK_MODEL}" > /tmp/oc-agent/current.info
rc=4
for attempt in 1 2 3; do
  # One stream so progress and tool steps stay in order; log lines are filtered out when shown.
  opencode run --print-logs --log-level INFO "${cont[@]}" "${model[@]}" "$*" >"$raw" 2>&1 </dev/null &
  pid=$!
  started=0
  for _ in $(seq 1 "$start_timeout"); do
    if grep -q 'message=loop' "$raw"; then started=1; break; fi
    kill -0 "$pid" 2>/dev/null || break
    sleep 1
  done
  if [ "$started" = 0 ] && kill -0 "$pid" 2>/dev/null; then
    kill "$pid" 2>/dev/null; sleep 2; kill -9 "$pid" 2>/dev/null; wait "$pid" 2>/dev/null
    echo "oc-agent: opencode did not start within ${start_timeout}s (attempt $attempt/3)" >&2
    continue
  fi
  wait "$pid"; rc=$?
  break
done
[ "$rc" != 4 ] || echo "oc-agent: opencode failed to start 3 times; see $raw" >&2
grep -v '^timestamp=' "$raw" | sed -r 's/\x1b\[[0-9;]*[A-Za-z]//g' > "$log"

echo "---- oc-agent exit=$rc, $(wc -l < "$log") log lines, last 80: ----"
tail -n 80 "$log"
exit "$rc"
